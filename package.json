{
  "name": "@hollowpoint-io/medusa-plugin-staff-permissions",
  "version": "0.1.0-lola.1",
  "description": "Server-enforced staff permissions for Medusa v2 — eight business areas, View/Manage grants, immutable recovery owners, atomic audit trail, fail-closed route inventory.",
  "author": "Billy Mahmood <https://hollowpoint.io>",
  "license": "MIT",
  "homepage": "https://hollowpoint.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollowpoint-io/medusa-plugin-staff-permissions.git"
  },
  "bugs": {
    "url": "https://github.com/hollowpoint-io/medusa-plugin-staff-permissions/issues"
  },
  "files": [
    ".medusa/server",
    "bin"
  ],
  "bin": {
    "staff-permissions-check": "./bin/staff-permissions-check.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./lib/access": "./.medusa/server/src/lib/access.js",
    "./lib/policy": "./.medusa/server/src/lib/policy.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa",
    "medusa-v2",
    "rbac",
    "permissions",
    "staff",
    "access-control"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests",
    "prepublishOnly": "medusa plugin:build",
    "inventory:list": "node scripts/list-core-routes.mjs",
    "inventory:diff": "node scripts/list-core-routes.mjs --diff src/lib/inventory/core-2.19.json",
    "leak-scan": "bash scripts/check-branding.sh"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "^5.64.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.17.0 <3",
    "@medusajs/cli": ">=2.17.0 <3",
    "@medusajs/framework": ">=2.17.0 <3",
    "@medusajs/icons": ">=2.17.0 <3",
    "@medusajs/js-sdk": ">=2.17.0 <3",
    "@medusajs/medusa": ">=2.17.0 <3",
    "@medusajs/test-utils": ">=2.17.0 <3",
    "@medusajs/ui": ">=4.0.0",
    "@tanstack/react-query": ">=5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.8.3"
}
